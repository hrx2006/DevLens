# DevLens AI Environment Configuration Example
PROJECT_NAME="DevLens AI"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./devlens.db

# Authentication & Session Security (Generate a 64+ char random string for production)
JWT_SECRET=your_super_secret_production_jwt_signing_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini AI Integration (Leave empty to use built-in deterministic reasoning fallback)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Crawler & SSRF Protection Limits
MAX_CRAWL_PAGES=10
CRAWL_TIMEOUT=20
MAX_RESPONSE_BYTES=5242880
SSRF_ALLOW_DEMO=true

# Server Network Settings
HOST=127.0.0.1
PORT=8000
