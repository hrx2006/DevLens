# DevLens AI Root Environment Configuration Example
PROJECT_NAME="DevLens AI"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./devlens.db

# Authentication Security
JWT_SECRET=your_super_secret_production_jwt_signing_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini AI Integration (Optional: fallback engine runs automatically if unset)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Crawler & SSRF Protection Limits
MAX_CRAWL_PAGES=10
CRAWL_TIMEOUT=20
MAX_RESPONSE_BYTES=5242880
SSRF_ALLOW_DEMO=true
